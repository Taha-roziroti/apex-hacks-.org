---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { GuideLandingPage } from '../../views/GuideLandingPage'
import { SEO, SITE_URL } from '../../data/site'
import { articleJsonLd, faqPageJsonLd } from '../../lib/seo'
import { PC_GUIDE_FAQS, PC_GUIDE_INTERNAL_LINKS, PC_GUIDE_SECTIONS } from '../../data/seo-landings'

const pageUrl = `${SITE_URL}/guides/apex-legends-cheats-pc`
const jsonLdExtra = [
  articleJsonLd({
    headline: SEO.guidePc.title,
    description: SEO.guidePc.description,
    path: SEO.guidePc.path,
  }),
  faqPageJsonLd(PC_GUIDE_FAQS, pageUrl),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'PC requirements', item: pageUrl },
    ],
  },
]
---

<BaseLayout seo={SEO.guidePc} jsonLdExtra={jsonLdExtra}>
  <GuideLandingPage
    client:idle
    currentPath="/guides/apex-legends-cheats-pc"
    breadcrumbLabel="Apex Legends cheats for PC"
    h1="Apex Legends Cheats for PC"
    intro="Windows 10/11, Steam or EA app, and patch-day loader status — what to verify before you buy Apex Legends cheats for PC."
    sections={PC_GUIDE_SECTIONS}
    internalLinks={PC_GUIDE_INTERNAL_LINKS}
    imageSrc="/media/apex-screenshot-6.webp"
    imageAlt="Apex Legends cheats running on Windows PC"
    faqs={PC_GUIDE_FAQS}
    faqHeading="Apex Legends PC cheat FAQ"
  />
</BaseLayout>
