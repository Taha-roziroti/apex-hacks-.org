---
import BaseLayout from '../layouts/BaseLayout.astro'
import { GameProductPage } from '../views/GameProductPage'
import { SEO, SITE_URL } from '../data/site'
import { productDetailJsonLd, faqPageJsonLd } from '../lib/seo'
import { getGame } from '../data/games'
import { BUY_PAGE_FAQS } from '../data/seo-landings'

const game = getGame('apex-legends')
const pageUrl = `${SITE_URL}/buy-apex-legends-cheats`
const jsonLdExtra = [
  productDetailJsonLd(game?.status ?? 'Updating'),
  faqPageJsonLd(BUY_PAGE_FAQS, pageUrl),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Product', item: `${SITE_URL}/apex-legends-cheats` },
      { '@type': 'ListItem', position: 3, name: 'Buy', item: pageUrl },
    ],
  },
]
---

<BaseLayout seo={SEO.buy} jsonLdExtra={jsonLdExtra}>
  <GameProductPage client:idle guideSlug="apex-legends-cheats" variant="buy" />
</BaseLayout>
