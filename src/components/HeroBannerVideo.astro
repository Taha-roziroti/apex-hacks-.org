---
import { APEX_HERO, APEX_HOME_VIDEO } from '../data/media'

const animated = APEX_HOME_VIDEO.src
const poster = APEX_HOME_VIDEO.poster
---

<div
  class="hero-video-wrap pointer-events-none absolute inset-0 z-0 overflow-hidden select-none"
  data-hero-video
  aria-hidden="true"
>
  <img
    class="hero-video-bg absolute inset-0 z-[1] h-full w-full object-cover object-center"
    src={animated}
    data-hero-animated={animated}
    data-hero-poster={poster}
    alt=""
    decoding="async"
    fetchpriority="high"
  />
  <div class="hero-video-tint pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div class="hero-video-tint-glow pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div
    class="absolute inset-x-0 bottom-0 z-[3] h-40 bg-gradient-to-t from-z-bg via-z-bg/80 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-x-0 top-0 z-[3] h-24 bg-gradient-to-b from-z-bg/70 to-transparent"
    aria-hidden="true"
  ></div>
</div>

<script is:inline define:vars={{ staticFallback: APEX_HERO }}>
  (function () {
    const wrap = document.querySelector('[data-hero-video]')
    const img = wrap?.querySelector('img.hero-video-bg')
    if (!img || !(img instanceof HTMLImageElement)) return
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const conn = navigator.connection
    if (reduce || (conn && conn.saveData)) {
      img.src = img.dataset.heroPoster || staticFallback
    }
  })()
</script>
