---
import { APEX_HERO_BANNER } from '../data/media'
---

<div
  class="hero-video-wrap pointer-events-none absolute inset-0 z-0 overflow-hidden select-none"
  data-hero-video
  aria-hidden="true"
>
  <img
    class="hero-video-bg absolute inset-0 z-[1] h-full w-full object-cover object-center"
    src={APEX_HERO_BANNER}
    alt=""
    width="3840"
    height="2160"
    decoding="async"
    fetchpriority="high"
  />
  <div class="hero-video-tint pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div class="hero-video-tint-glow pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div
    class="absolute inset-x-0 bottom-0 z-[3] h-40 bg-gradient-to-t from-z-bg via-z-bg/80 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-x-0 top-0 z-[3] h-24 bg-gradient-to-b from-z-bg/70 to-transparent"
    aria-hidden="true"
  ></div>
</div>
